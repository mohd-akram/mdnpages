.TH "FILEREADER.LOADEND_EVENT" "3JS" "July 28, 2026" "JavaScript" "JavaScript Reference Manual"
.SH NAME
FileReader.loadend_event \- FileReader: loadend event
.SH SYNOPSIS
\f[B]Note:\f[R] This feature is available in Web Workers.
.PP
The \f[B]\f[CB]loadend\f[B]\f[R] event of the \f[CR]FileReader\f[R]
interface is fired when a file read has completed, successfully or not.
.PP
This event is not cancelable and does not bubble.
.SH SYNTAX
Use the event name in methods like \f[CR]addEventListener()\f[R], or set
an event handler property.
.IP
.EX
addEventListener(\(dqloadend\(dq, (event) => { })

onloadend = (event) => { }
.EE
.SH EVENT TYPE
A \f[CR]ProgressEvent\f[R].
Inherits from \f[CR]Event\f[R].
.SH EXAMPLES
.SS Live example
.SS HTML
.IP
.EX
<\f[B]div\f[R] class=\(dqexample\(dq>
  <\f[B]div\f[R] class=\(dqfile\-select\(dq>
    <\f[B]label\f[R] for=\(dqavatar\(dq>Choose a profile picture:</\f[B]label\f[R]>
    <\f[B]input\f[R]
      type=\(dqfile\(dq
      id=\(dqavatar\(dq
      name=\(dqavatar\(dq
      accept=\(dqimage/png, image/jpeg\(dq />
  </\f[B]div\f[R]>

  <\f[B]img\f[R] src=\(dq\(dq class=\(dqpreview\(dq height=\(dq200\(dq alt=\(dqImage preview\(dq />

  <\f[B]div\f[R] class=\(dqevent\-log\(dq>
    <\f[B]label\f[R] for=\(dqeventLog\(dq>Event log:</\f[B]label\f[R]>
    <\f[B]textarea\f[R] readonly class=\(dqevent\-log\-contents\(dq id=\(dqeventLog\(dq></\f[B]textarea\f[R]>
  </\f[B]div\f[R]>
</\f[B]div\f[R]>
.EE
.SS JavaScript
.IP
.EX
\f[B]const\f[R] fileInput = document.querySelector(\(aqinput[type=\(dqfile\(dq]\(aq);
\f[B]const\f[R] preview = document.querySelector(\(dqimg.preview\(dq);
\f[B]const\f[R] eventLog = document.querySelector(\(dq.event\-log\-contents\(dq);
\f[B]const\f[R] reader = \f[B]new\f[R] FileReader();

\f[B]function\f[R] handleEvent(event) {
  eventLog.textContent += \(ga${event.type}: ${event.loaded} bytes transferred\(rsn\(ga;

  \f[B]if\f[R] (event.type === \(dqload\(dq) {
    preview.src = reader.result;
  }
}

\f[B]function\f[R] addListeners(reader) {
  reader.addEventListener(\(dqloadstart\(dq, handleEvent);
  reader.addEventListener(\(dqload\(dq, handleEvent);
  reader.addEventListener(\(dqloadend\(dq, handleEvent);
  reader.addEventListener(\(dqprogress\(dq, handleEvent);
  reader.addEventListener(\(dqerror\(dq, handleEvent);
  reader.addEventListener(\(dqabort\(dq, handleEvent);
}

\f[B]function\f[R] handleSelected(e) {
  eventLog.textContent = \(dq\(dq;
  \f[B]const\f[R] selectedFile = fileInput.files[0];
  \f[B]if\f[R] (selectedFile) {
    addListeners(reader);
    reader.readAsDataURL(selectedFile);
  }
}

fileInput.addEventListener(\(dqchange\(dq, handleSelected);
.EE
