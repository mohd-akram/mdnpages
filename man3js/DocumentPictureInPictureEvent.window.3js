.TH "DOCUMENTPICTUREINPICTUREEVENT.WINDOW" "3JS" "April 25, 2026" "JavaScript" "JavaScript Reference Manual"
.SH NAME
DocumentPictureInPictureEvent.window \- DocumentPictureInPictureEvent:
window property
.SH SYNOPSIS
\f[B]Secure context:\f[R] This feature is available only in secure
contexts (HTTPS).
.PP
The \f[B]\f[CB]window\f[B]\f[R] read\-only property of the
\f[CR]DocumentPictureInPictureEvent\f[R] interface returns a
\f[CR]Window\f[R] instance representing the browsing context inside the
\f[CR]DocumentPictureInPicture\f[R] window the event was fired on.
.SH VALUE
A \f[CR]Window\f[R] object instance.
.SH EXAMPLES
.IP
.EX
documentPictureInPicture.addEventListener(\(dqenter\(dq, (event) \f[B]=>\f[R] {
  \f[B]const\f[R] pipWindow = event.window;
  console.log(\(dqVideo player has entered the pip window\(dq);

  \f[B]const\f[R] pipMuteButton = pipWindow.document.createElement(\(dqbutton\(dq);
  pipMuteButton.textContent = \(dqMute\(dq;
  pipMuteButton.addEventListener(\(dqclick\(dq, () \f[B]=>\f[R] {
    \f[B]const\f[R] pipVideo = pipWindow.document.querySelector(\(dq#video\(dq);
    \f[B]if\f[R] (!pipVideo.muted) {
      pipVideo.muted = \f[B]true\f[R];
      pipMuteButton.textContent = \(dqUnmute\(dq;
    } \f[B]else\f[R] {
      pipVideo.muted = \f[B]false\f[R];
      pipMuteButton.textContent = \(dqMute\(dq;
    }
  });

  pipWindow.document.body.append(pipMuteButton);
});
.EE
