.TH "WEBTRANSPORT.SUPPORTSRELIABLEONLY_STATIC" "3JS" "October 12, 2026" "JavaScript" "JavaScript Reference Manual"
.SH NAME
WebTransport.supportsReliableOnly_static \- WebTransport:
supportsReliableOnly static property
.SH SYNOPSIS
\f[B]Secure context:\f[R] This feature is available only in secure
contexts (HTTPS).
.PP
\f[B]Note:\f[R] This feature is available in Web Workers.
.PP
The \f[B]\f[CB]supportsReliableOnly\f[B]\f[R] static read\-only property
of the \f[CR]WebTransport\f[R] interface returns a boolean value that
indicates whether the browser supports \f[CR]WebTransport\f[R] sessions
over exclusively reliable transports, such as HTTP/2.
Such sessions can\(cqt send unreliable datagrams, which need HTTP/3 over
QUIC.
.SH VALUE
A boolean value: \f[CR]true\f[R] if the browser supports reliable\-only
\f[CR]WebTransport\f[R] sessions, \f[CR]false\f[R] otherwise.
.SH EXAMPLES
.SS Basic usage
.IP
.EX
\f[B]const\f[R] url = \(dqhttps://example.com:4999/webtransport\(dq;

\f[B]async\f[R] \f[B]function\f[R] connect() {
  \f[I]// WebTransport itself may be unavailable, so check before reading the static property\f[R]
  \f[B]if\f[R] (\f[B]typeof\f[R] WebTransport === \(dqundefined\(dq) {
    console.log(\(dqWebTransport is not supported in this browser.\(dq);
    \f[B]return\f[R];
  }

  \f[I]// Without reliable\-only support, the session needs HTTP/3,\f[R]
  \f[I]// so it fails on networks that block UDP\f[R]
  \f[B]if\f[R] (!WebTransport.supportsReliableOnly) {
    console.log(\(dqThis browser can\(aqt fall back to a reliable\-only session.\(dq);
  }

  \f[B]const\f[R] transport = \f[B]new\f[R] WebTransport(url);

  \f[B]try\f[R] {
    \f[B]await\f[R] transport.ready;
    console.log(\(dqConnected\(dq);
  } \f[B]catch\f[R] (error) {
    console.error(\(dqConnection failed:\(dq, error);
  }
}

connect();
.EE
